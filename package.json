{
  "name": "clearport",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "tools:build": "tsc -p tsconfig.tools.json",
    "test": "npm run tools:build && node --test .clearport-tools/tests/ingest.test.js",
    "seed": "npm run tools:build && node .clearport-tools/scripts/seed.js",
    "seed:check": "npm run seed -- --dry-run",
    "seed:verify": "npm run seed -- --verify-only"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
