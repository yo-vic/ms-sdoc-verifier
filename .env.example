# Copy to .env Never commit actual credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server/script only. NEVER use a NEXT_PUBLIC prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Retain the existing GEMINI_API_KEY in .env; no AI calls in Phase 1.
GEMINI_MODEL=gemini-3.1-flash-lite
# Folder containing inbox/ + attachments/, or http://localhost:8080
DATASET_SOURCE=.
